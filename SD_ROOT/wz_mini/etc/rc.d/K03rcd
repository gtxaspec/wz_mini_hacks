#!/bin/sh

if [ -e /tmp/dbgflag ]; then
	echo "debug enabled, rc.d disabled."
	exit 0
fi

# Intentionally explicit list: this fork only runs USB Ethernet related rc.d stages.
for i in \
	/opt/wz_mini/etc/rc.d/S01swap \
	/opt/wz_mini/etc/rc.d/S03ethernet \
	/opt/wz_mini/etc/rc.d/S06networkalt \
	/opt/wz_mini/etc/rc.d/S10firmware
do
	# Ignore missing scripts.
	[ ! -f "$i" ] && continue

	case "$i" in
		*.sh)
			# Source shell script for speed.
			(
				trap - INT QUIT TSTP
				set start
				. $i
			)
			;;
		*)
			# No sh extension, so fork subprocess.
			$i start
			;;
	esac
done
